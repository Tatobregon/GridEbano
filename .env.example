# Plantilla de configuración. Copiá este archivo como  .env  y completá los valores.
#   cp .env.example .env   (y editá los valores)
# El .env real NO se versiona.
#
# SECRETOS: usá SOLO letras y números (sin @ : / # ? % ni espacios). La clave de CouchDB va metida
# dentro de URLs (en los scripts y en couch-auth) y esos caracteres la rompen.
# Para generarlos en Linux:  openssl rand -hex 24
COUCHDB_PASSWORD=cambiame
REGISTER_SECRET=cambiame
# Clave de acceso a la página de admin para crear usuarios (/crear-usuario-ebano-soluciones)
ADMIN_UI_PASSWORD=cambiame

# --- URL pública de ESTE entorno ---
# La URL por la que los usuarios entran a ESTE servidor, con https:// y SIN barra final.
#   - En la PC de testeo: la URL del Tailscale Funnel (ej: https://tu-pc.tu-tailnet.ts.net)
#   - En el servidor de producción: tu dominio (ej: https://app.tudominio.com.ar)
# OJO: se HORNEA en el bundle del frontend al compilar → si la cambiás, rebuildeá el frontend
# (docker compose up -d --build frontend). La URL de CouchDB se arma sola: AUTH_BASE_URL + /couchdb/
AUTH_BASE_URL=https://cambiame.tudominio.com.ar

# Versión visible en "Acerca de". Subila cada vez que cambies el frontend (invalida el cache del
# service worker y los navegadores toman la versión nueva).
ASTERICS_VERSION=localdev-15

# --- SOLO en el servidor de producción (dejalas vacías / comentadas en la PC local) ---
# Activa Caddy (HTTPS automático con Let's Encrypt).
#COMPOSE_PROFILES=prod
# Dominio SIN https:// (el mismo de AUTH_BASE_URL). Tiene que apuntar (registro A) a la IP del server.
#SITE_DOMAIN=app.tudominio.com.ar
# Mail para los avisos de Let's Encrypt (vencimientos, problemas con el certificado).
#ACME_EMAIL=tu-mail@tudominio.com.ar

# --- Backups ---
# En el server, la copia fuera del disco la hacen las "Copias de Seguridad" de DonWeb (se llevan el
# server entero, incluidos los .tgz de backups/). El cron corre  backup.sh --consistente  a secas.
# Opcional: avisar a un monitor externo cuando el backup salió bien (ej. healthchecks.io). Si una
# noche no llega el aviso, te manda un mail.
#BACKUP_PING_URL=https://hc-ping.com/xxxxxxxx
# Opcional: destino de rclone para backup-offsite.sh (si algún día copiás a otro proveedor).
#RCLONE_DESTINO=mi-remote-cifrado:
