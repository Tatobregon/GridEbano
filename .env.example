# Plantilla de secretos. Copiá este archivo como  .env  y poné valores fuertes.
#   cp .env.example .env   (y editá los valores)
# El .env real NO se versiona.
COUCHDB_PASSWORD=cambiame-por-una-clave-fuerte-y-larga
REGISTER_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
# Clave de acceso a la página de admin para crear usuarios
ADMIN_UI_PASSWORD=cambiame-por-una-clave-de-acceso

# --- URLs públicas de ESTE entorno (parametrizadas para poder desplegar en varios lados) ---
# Deben apuntar al dominio/URL por el que los usuarios acceden a ESTE servidor.
#   - En la PC de testeo: la URL del Tailscale Funnel (ej: https://pc-tato.taila78f74.ts.net)
#   - En el servidor de producción: tu dominio con HTTPS (ej: https://grid.tudominio.com)
# OJO: AUTH_BASE_URL se HORNEA en el bundle del frontend al compilar → si la cambiás, rebuildeá el
# frontend (docker compose up -d --build frontend).
AUTH_BASE_URL=https://cambiame.tudominio.com
# La URL pública de CouchDB SIEMPRE es AUTH_BASE_URL + /couchdb/  (nginx la proxea same-origin).
DB_SERVER_PUBLIC_URL=https://cambiame.tudominio.com/couchdb/
