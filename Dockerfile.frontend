# ── Stage: datos de tableros self-hosted (mirror PINEADO de Asterics-AAC-Data) ──
# Servido luego same-origin por nuestro nginx, así NO dependemos de asterics.github.io:
# las imágenes, miniaturas y tableros predefinidos salen de NUESTRO servidor.
# Imagen mínima con git (así un parche de Node no obliga a re-bajar los ~285 MB de tableros).
FROM alpine:3 AS boards
ARG BOARDS_COMMIT
RUN apk add --no-cache git
WORKDIR /boards
RUN git init -q \
    && git remote add origin https://github.com/asterics/Asterics-AAC-Data.git \
    && git fetch -q --depth 1 origin "${BOARDS_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && rm -rf /boards/.git

# ── Stage: build del frontend ──
# Node 22: la misma versión con la que compila el CI del upstream. (node:18 dejó de recibir
# parches en 2025: por eso se cambió.)
FROM node:22-bookworm AS build
ARG ASTERICS_TAG
ARG AUTH_BASE_URL
ARG ASTERICS_VERSION
WORKDIR /src

RUN git clone https://github.com/asterics/AsTeRICS-Grid.git . \
    && git checkout "tags/${ASTERICS_TAG}"

# Cada `sed` va seguido de un `grep -q` que verifica que el cambio se aplicó: si el upstream cambia
# y el patrón ya no matchea, el build FALLA en vez de seguir en silencio (igual que los patches .js).

# (0) La URL pública tiene que venir del .env, completa y sin barra final (si no, el login y el sync
# quedan apuntando mal y recién te das cuenta con la app abierta).
RUN case "${AUTH_BASE_URL}" in \
      http://*[!/]|https://*[!/]) ;; \
      *) echo "ERROR: AUTH_BASE_URL='${AUTH_BASE_URL}' (tiene que ser https://dominio, sin barra final; revisá el .env)"; exit 1;; \
    esac

# (1) Apuntar el frontend a NUESTRO couch-auth (URL completa)
RUN sed -i "s#https://login1.couchdb.asterics-foundation.org#${AUTH_BASE_URL}#g" \
      src/js/service/loginService.js \
    && grep -q "${AUTH_BASE_URL}" src/js/service/loginService.js

# (1b) Self-host del repo de tableros: apuntar a NUESTRA copia same-origin en /Asterics-AAC-Data/.
# Ruta root-relative → funciona en localhost y en cualquier dominio de prod sin cambios, y sin CORS.
RUN sed -i "s#https://asterics.github.io/Asterics-AAC-Data/#/Asterics-AAC-Data/#g" \
      src/js/util/constants.js src/js/service/boards/boardService.js \
    && grep -q '"/Asterics-AAC-Data/"' src/js/util/constants.js \
    && grep -q '"/Asterics-AAC-Data/"' src/js/service/boards/boardService.js

# (1c) Sync resiliente: el upstream usa `retry: false` (asume server estable). En nuestro setup,
# cualquier blip transitorio dispara el handler de error → cancela el sync y muestra la X.
# Con `retry: true`, PouchDB reintenta solo y no latchea la falla.
# OJO (revisión 2026-09-22): con retry:true, si el server está caído el ícono queda en VERDE
# (PouchDB avisa la falla como "paused"). Ver docs/runbook-prod.md, test de caída.
RUN sed -i "s/retry: false/retry: true/g" src/js/service/data/pouchDbAdapter.js \
    && grep -q "retry: true" src/js/service/data/pouchDbAdapter.js

# (1d) Cache-busting del service worker: el release ya reemplazó #ASTERICS_GRID_VERSION#, así que
# nuestro serviceWorker.js queda idéntico build a build y el navegador nunca actualiza (sirve el
# bundle viejo). Versionamos el nombre del cache con ASTERICS_VERSION → cada build cambia el SW.
RUN sed -i "s/APP_CACHE_NAME = \"app-cache\"/APP_CACHE_NAME = \"app-cache-${ASTERICS_VERSION}\"/" serviceWorker.js \
    && grep -q "app-cache-${ASTERICS_VERSION}" serviceWorker.js

# (1e) AGPL: link visible al código fuente de ESTA versión modificada en la pantalla "Acerca de".
COPY scripts/patch-about-link.js /tmp/patch-about-link.js
RUN node /tmp/patch-about-link.js

# (1f) Limpieza: elimina la última referencia (muerta) a la fundación en el service worker
# (check de cacheo de tableros) y lo corrige a same-origin. Desacople total, hasta en código muerto.
COPY scripts/patch-sw-boards-check.js /tmp/patch-sw-boards-check.js
RUN node /tmp/patch-sw-boards-check.js

# (1g) Desacople TOTAL: neutraliza las 2 features opcionales que llamaban a la fundación
# (podcast + CORS-proxy) → apuntan a un 404 same-origin y degradan solas. Cero refs a la fundación.
COPY scripts/patch-remove-foundation-features.js /tmp/patch-remove-foundation-features.js
RUN node /tmp/patch-remove-foundation-features.js

# (1h) App SOLO-LOGIN: quita de la UI toda opción de crear usuarios (registro online + usuario
# offline). Las cuentas las crea SOLO el admin (página /crear-usuario-ebano-soluciones). Neutraliza
# también las rutas #register/#add/#welcome → renderizan el login (defensa en profundidad).
COPY scripts/patch-remove-register-ui.js /tmp/patch-remove-register-ui.js
RUN node /tmp/patch-remove-register-ui.js

# (1i) Indicador visual de dwell: al posar el mouse sobre un elemento (hovering/"superposición"),
# un círculo se va llenando (tipo reloj) durante el tiempo de dwell hasta que se dispara el click.
# Puro CSS, enganchado al ciclo de vida existente de hovering.js. Ver scripts/patch-hover-clock.js.
COPY scripts/patch-hover-clock.js /tmp/patch-hover-clock.js
RUN node /tmp/patch-hover-clock.js

# (1j) Re-marca EBANO: logo de la empresa en el header/favicon/PWA, manteniendo "by AsTeRICS Grid"
# como atribución de autoría (AGPL). Los archivos de imagen se copian abajo, en la etapa final.
COPY scripts/patch-branding.js /tmp/patch-branding.js
RUN node /tmp/patch-branding.js

# (1j2) Ventana "Acerca de este comunicador": se abre al tocar el logo. Agradece a AsTeRICS y
# ARASAAC, muestra los tres logos y deja a mano el link al código fuente (AGPL). Va DESPUÉS del
# branding, que es el que engancha el logo con esta ventana.
COPY scripts/patch-creditos.js /tmp/patch-creditos.js
RUN node /tmp/patch-creditos.js

# (1k) Saca del menú de navegación "Acerca de" y "Ayuda" (los clientes no deben tocar ahí). NO borra
# la info: las páginas #about/#help siguen existiendo por URL. Ver scripts/patch-remove-nav-about-help.js.
COPY scripts/patch-remove-nav-about-help.js /tmp/patch-remove-nav-about-help.js
RUN node /tmp/patch-remove-nav-about-help.js

# (2) Entorno PROD + versión (la versión invalida el cache del service worker al actualizar)
RUN sed -i "s/#ASTERICS_GRID_ENV#/PROD/g"            src/js/util/constants.js \
    && sed -i "s/#ASTERICS_GRID_VERSION#/${ASTERICS_VERSION}/g" src/js/util/constants.js \
    && sed -i "s/#ASTERICS_GRID_VERSION#/${ASTERICS_VERSION}/g" src/vue-components/views/aboutView.vue \
    && sed -i "s/#ASTERICS_GRID_VERSION#/${ASTERICS_VERSION}/g" serviceWorker.js \
    && grep -q "ENVIRONMENT = 'PROD'" src/js/util/constants.js

# Dependencias CONGELADAS: el upstream no commitea package-lock.json, así que usamos el nuestro
# (locks/), que registra la versión exacta de cada paquete. `npm ci` instala exactamente eso: un
# rebuild (o un parcheo) ya no puede traer versiones distintas de las probadas.
COPY locks/frontend-package-lock.json /src/package-lock.json
RUN npm ci --no-audit --no-fund
RUN npx webpack --config webpack.config.js --env production \
    && node scripts/getServiceWorkerCachePaths.js
# Lo que NO se publica: dependencias de build y la historia de git (antes quedaban descargables
# en /node_modules/ y /.git/ del sitio).
RUN rm -rf node_modules .git

# nginx de la rama ESTABLE (se republica con parches; 1.27 era mainline y quedó congelada en 2025).
FROM nginx:stable-alpine
COPY --from=build /src/ /usr/share/nginx/html/
# Logos de EBANO (referenciados por el header/manifest/favicon ya parcheados en la etapa build).
COPY branding/ebano-logo.png                /usr/share/nginx/html/app/img/ebano-logo.png
COPY branding/ebano-icon-512.png            /usr/share/nginx/html/app/img/ebano-icon-512.png
COPY branding/ebano-icon-maskable-512.png   /usr/share/nginx/html/app/img/ebano-icon-maskable-512.png
COPY branding/ebano-favicon-96.png          /usr/share/nginx/html/app/img/ebano-favicon-96.png
# Mirror self-hosted del repo de tableros, servido same-origin en /Asterics-AAC-Data/
COPY --from=boards /boards/ /usr/share/nginx/html/Asterics-AAC-Data/
# Config de nginx como puerta única (reverse-proxy de couch-auth y couchdb + security headers).
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
# Página de admin para crear usuarios (servida en /crear-usuario-ebano-soluciones).
COPY nginx/admin-crear-usuario.html /usr/share/nginx/html/admin-crear-usuario.html
