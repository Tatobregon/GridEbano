# ── Stage: datos de tableros self-hosted (mirror PINEADO de Asterics-AAC-Data) ──
# Servido luego same-origin por nuestro nginx, así NO dependemos de asterics.github.io:
# las imágenes, miniaturas y tableros predefinidos salen de NUESTRO servidor.
FROM node:18-bullseye AS boards
ARG BOARDS_COMMIT
WORKDIR /boards
RUN git init -q \
    && git remote add origin https://github.com/asterics/Asterics-AAC-Data.git \
    && git fetch -q --depth 1 origin "${BOARDS_COMMIT}" \
    && git checkout -q FETCH_HEAD \
    && rm -rf /boards/.git

# ── Stage: build del frontend ──
FROM node:18-bullseye AS build
ARG ASTERICS_TAG
ARG AUTH_BASE_URL
ARG ASTERICS_VERSION
WORKDIR /src

RUN git clone https://github.com/asterics/AsTeRICS-Grid.git . \
    && git checkout "tags/${ASTERICS_TAG}"

# (1) Apuntar el frontend a NUESTRO couch-auth (URL completa; sirve para http://localhost:3000)
RUN sed -i "s#https://login1.couchdb.asterics-foundation.org#${AUTH_BASE_URL}#g" \
    src/js/service/loginService.js

# (1b) Self-host del repo de tableros: apuntar a NUESTRA copia same-origin en /Asterics-AAC-Data/.
# Ruta root-relative → funciona en localhost y en cualquier dominio de prod sin cambios, y sin CORS.
RUN sed -i "s#https://asterics.github.io/Asterics-AAC-Data/#/Asterics-AAC-Data/#g" \
    src/js/util/constants.js src/js/service/boards/boardService.js

# (1c) Sync resiliente: el upstream usa `retry: false` (asume server estable). En nuestro setup,
# cualquier blip transitorio dispara el handler de error → cancela el sync y muestra la X para
# siempre. Con `retry: true`, PouchDB reintenta solo y no latchea la falla.
RUN sed -i "s/retry: false/retry: true/g" src/js/service/data/pouchDbAdapter.js

# (1d) Cache-busting del service worker: el release ya reemplazó #ASTERICS_GRID_VERSION#, así que
# nuestro serviceWorker.js queda idéntico build a build y el navegador nunca actualiza (sirve el
# bundle viejo). Versionamos el nombre del cache con ASTERICS_VERSION → cada build cambia el SW.
RUN sed -i "s/APP_CACHE_NAME = \"app-cache\"/APP_CACHE_NAME = \"app-cache-${ASTERICS_VERSION}\"/" serviceWorker.js

# (2) Entorno PROD + versión (la versión invalida el cache del service worker al actualizar)
RUN sed -i "s/#ASTERICS_GRID_ENV#/PROD/g"            src/js/util/constants.js \
    && sed -i "s/#ASTERICS_GRID_VERSION#/${ASTERICS_VERSION}/g" src/js/util/constants.js \
    && sed -i "s/#ASTERICS_GRID_VERSION#/${ASTERICS_VERSION}/g" src/vue-components/views/aboutView.vue \
    && sed -i "s/#ASTERICS_GRID_VERSION#/${ASTERICS_VERSION}/g" serviceWorker.js

# El repo upstream no commitea package-lock.json, así que `npm ci` falla.
# Usamos `npm install` (el tag está pineado, así que sigue siendo reproducible en la práctica).
RUN npm install
RUN npx webpack --config webpack.config.js --env production \
    && node scripts/getServiceWorkerCachePaths.js

FROM nginx:1.27-alpine
COPY --from=build /src/ /usr/share/nginx/html/
# Mirror self-hosted del repo de tableros, servido same-origin en /Asterics-AAC-Data/
COPY --from=boards /boards/ /usr/share/nginx/html/Asterics-AAC-Data/
# Config de nginx como puerta única (reverse-proxy de couch-auth y couchdb + security headers).
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
