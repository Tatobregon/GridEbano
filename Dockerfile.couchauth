# ── Stage: código + dependencias + patches (necesita git) ──
# Node 22: la misma versión con la que compila el CI del upstream. (node:18 dejó de recibir
# parches en 2025: por eso se cambió.)
FROM node:22-bookworm AS build
ARG ASTERICS_TAG
WORKDIR /app
RUN git clone https://github.com/asterics/AsTeRICS-Grid.git . \
    && git checkout "tags/${ASTERICS_TAG}" \
    && rm -rf .git
# Dependencias CONGELADAS (ver locks/): `npm ci` instala exactamente las versiones probadas.
# (No se usa --omit=dev: start.js necesita `nano`, que el upstream declara como devDependency.)
COPY locks/couchauth-package-lock.json /app/package-lock.json
RUN npm ci --no-audit --no-fund
# Bloquear el registro público: /auth/register solo pasa con el header X-Register-Secret correcto.
COPY scripts/patch-couchauth.js /tmp/patch-couchauth.js
RUN node /tmp/patch-couchauth.js
# Endpoints de la página de admin para crear usuarios (gated por ADMIN_UI_PASSWORD; secreto server-side).
COPY scripts/patch-admin-endpoints.js /tmp/patch-admin-endpoints.js
RUN node /tmp/patch-admin-endpoints.js

# ── Stage: runtime (imagen slim, sin git ni compiladores) ──
FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app /app
# Corre como usuario sin privilegios (el que trae la imagen oficial de node), no como root.
USER node
EXPOSE 3000
CMD ["node", "superlogin/start.js"]
