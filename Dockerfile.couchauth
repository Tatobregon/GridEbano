FROM node:18-bullseye
ARG ASTERICS_TAG
WORKDIR /app
RUN git clone https://github.com/asterics/AsTeRICS-Grid.git . \
    && git checkout "tags/${ASTERICS_TAG}"
# El repo upstream no commitea package-lock.json → `npm ci` falla. Usamos `npm install`.
RUN npm install
# Bloquear el registro público: /auth/register solo pasa con el header X-Register-Secret correcto.
COPY scripts/patch-couchauth.js /tmp/patch-couchauth.js
RUN node /tmp/patch-couchauth.js
# Endpoints de la página de admin para crear usuarios (gated por ADMIN_UI_PASSWORD; secreto server-side).
COPY scripts/patch-admin-endpoints.js /tmp/patch-admin-endpoints.js
RUN node /tmp/patch-admin-endpoints.js
EXPOSE 3000
CMD ["node", "superlogin/start.js"]
